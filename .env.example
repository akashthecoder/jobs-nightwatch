# Copy to .env and fill in your own values.
#   cp .env.example .env
#
# Auth: this project uses Vertex AI mode (not an API key).
# Before running anything, authenticate with:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project <your-project-id>

GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your-project-id

# Vertex AI location for Gemini calls.
# IMPORTANT: must be "global". Gemini 3.x publisher models are NOT served from
# regional endpoints — every 3.x model 404s in us-central1 but resolves on global.
GOOGLE_CLOUD_LOCATION=global

# Region for Firestore, Cloud Run and Pub/Sub. Deliberately a SEPARATE variable
# from GOOGLE_CLOUD_LOCATION above — these are different services and conflating
# them produces confusing 404s from the Gemini API.
GCP_REGION=us-central1

# Gemini model ID.
# NOTE: Vertex AI does not accept AI Studio's "-latest" aliases (gemini-flash-latest
# 404s here). Use an explicit version.
GEMINI_MODEL=gemini-3.7-flash

# Pub/Sub topic carrying detected job-posting changes to the agent.
PUBSUB_TOPIC=job-changes
